#!/usr/bin/env bash
# Optimize pionia-core for release (autoload classmap + framework preload manifest).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

php -r "
require 'vendor/autoload.php';
\$result = (new Pionia\Performance\FrameworkReleaseOptimizer(getcwd()))->optimize();
if (!\$result['autoload']) {
    fwrite(STDERR, 'composer dump-autoload -o failed' . PHP_EOL);
    exit(1);
}
echo 'Autoload optimized.' . PHP_EOL;
if (\$result['preload_files'] !== null) {
    echo 'Framework package preload: ' . \$result['preload_files'] . ' files → ' . \$result['preload_path'] . PHP_EOL;
    echo 'This file ships inside the Packagist zip (portable paths).' . PHP_EOL;
}
"
