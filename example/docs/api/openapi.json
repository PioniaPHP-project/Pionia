{
    "openapi": "3.1.0",
    "info": {
        "title": "Sample App Moonlight API",
        "version": "1.0.0",
        "description": "Pionia Moonlight profile \u2014 dispatch via { service, action, ...params } on versioned API paths."
    },
    "paths": {
        "/api/v1": {
            "post": {
                "summary": "Moonlight dispatch (POST)",
                "tags": [
                    "Moonlight"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "oneOf": [
                                    {
                                        "$ref": "#/components/schemas/auth.create_auth"
                                    },
                                    {
                                        "$ref": "#/components/schemas/auth.delete_auth"
                                    },
                                    {
                                        "$ref": "#/components/schemas/auth.get_auth"
                                    },
                                    {
                                        "$ref": "#/components/schemas/auth.list_auth"
                                    },
                                    {
                                        "$ref": "#/components/schemas/auth.update_auth"
                                    },
                                    {
                                        "$ref": "#/components/schemas/category.bulk"
                                    },
                                    {
                                        "$ref": "#/components/schemas/category.list"
                                    },
                                    {
                                        "$ref": "#/components/schemas/category.save_or_update"
                                    },
                                    {
                                        "$ref": "#/components/schemas/category.update"
                                    },
                                    {
                                        "$ref": "#/components/schemas/sampolo.create"
                                    },
                                    {
                                        "$ref": "#/components/schemas/sampolo.delete"
                                    },
                                    {
                                        "$ref": "#/components/schemas/sampolo.details"
                                    },
                                    {
                                        "$ref": "#/components/schemas/sampolo.edit"
                                    },
                                    {
                                        "$ref": "#/components/schemas/sampolo.list"
                                    },
                                    {
                                        "$ref": "#/components/schemas/sampolo.random"
                                    },
                                    {
                                        "$ref": "#/components/schemas/sampolo.retrieve"
                                    },
                                    {
                                        "$ref": "#/components/schemas/sampolo.save"
                                    },
                                    {
                                        "$ref": "#/components/schemas/sampolo.update"
                                    }
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "$ref": "#/components/responses/PioniaEnvelope"
                    }
                }
            }
        },
        "/api/v1/{service}/{action}/": {
            "get": {
                "summary": "Moonlight dispatch (GET)",
                "tags": [
                    "Moonlight"
                ],
                "parameters": [
                    {
                        "name": "service",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "action",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "$ref": "#/components/responses/PioniaEnvelope"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "PioniaEnvelope": {
                "type": "object",
                "required": [
                    "returnCode",
                    "returnMessage"
                ],
                "properties": {
                    "returnCode": {
                        "type": "integer"
                    },
                    "returnMessage": {
                        "type": "string"
                    },
                    "returnData": {
                        "type": "object",
                        "nullable": true
                    },
                    "extraData": {
                        "type": "object",
                        "nullable": true
                    }
                }
            },
            "auth.create_auth": {
                "type": "object",
                "required": [
                    "service",
                    "action"
                ],
                "properties": {
                    "service": {
                        "const": "auth"
                    },
                    "action": {
                        "const": "create_auth"
                    },
                    "username": {
                        "type": "string",
                        "description": "Login name"
                    },
                    "password": {
                        "type": "string",
                        "description": "Secret"
                    }
                },
                "description": "Creates an auth record"
            },
            "auth.delete_auth": {
                "type": "object",
                "required": [
                    "service",
                    "action"
                ],
                "properties": {
                    "service": {
                        "const": "auth"
                    },
                    "action": {
                        "const": "delete_auth"
                    },
                    "id": {
                        "type": "integer",
                        "description": "Record id"
                    }
                },
                "description": "Deletes an auth record"
            },
            "auth.get_auth": {
                "type": "object",
                "required": [
                    "service",
                    "action"
                ],
                "properties": {
                    "service": {
                        "const": "auth"
                    },
                    "action": {
                        "const": "get_auth"
                    }
                },
                "description": "Returns auth context for the current request"
            },
            "auth.list_auth": {
                "type": "object",
                "required": [
                    "service",
                    "action"
                ],
                "properties": {
                    "service": {
                        "const": "auth"
                    },
                    "action": {
                        "const": "list_auth"
                    }
                },
                "description": "Lists auth records (demo stub)"
            },
            "auth.update_auth": {
                "type": "object",
                "required": [
                    "service",
                    "action"
                ],
                "properties": {
                    "service": {
                        "const": "auth"
                    },
                    "action": {
                        "const": "update_auth"
                    },
                    "id": {
                        "type": "integer",
                        "description": "Record id"
                    }
                },
                "description": "Updates an auth record"
            },
            "category.bulk": {
                "type": "object",
                "required": [
                    "service",
                    "action"
                ],
                "properties": {
                    "service": {
                        "const": "category"
                    },
                    "action": {
                        "const": "bulk"
                    },
                    "id": {
                        "type": "integer",
                        "description": "Skill id"
                    }
                },
                "description": "Returns one skill row by id"
            },
            "category.list": {
                "type": "object",
                "required": [
                    "service",
                    "action"
                ],
                "properties": {
                    "service": {
                        "const": "category"
                    },
                    "action": {
                        "const": "list"
                    }
                },
                "description": "Lists skill rows"
            },
            "category.save_or_update": {
                "type": "object",
                "required": [
                    "service",
                    "action"
                ],
                "properties": {
                    "service": {
                        "const": "category"
                    },
                    "action": {
                        "const": "save_or_update"
                    },
                    "data": {
                        "type": "object",
                        "description": "Row payload"
                    }
                },
                "description": "Upserts a skill record"
            },
            "category.update": {
                "type": "object",
                "required": [
                    "service",
                    "action"
                ],
                "properties": {
                    "service": {
                        "const": "category"
                    },
                    "action": {
                        "const": "update"
                    },
                    "id": {
                        "type": "integer",
                        "description": "Row id"
                    },
                    "name": {
                        "type": "string",
                        "description": "New name"
                    }
                },
                "description": "Updates a company record"
            },
            "sampolo.create": {
                "type": "object",
                "required": [
                    "service",
                    "action"
                ],
                "properties": {
                    "service": {
                        "const": "sampolo"
                    },
                    "action": {
                        "const": "create"
                    }
                },
                "description": "Create a new row"
            },
            "sampolo.delete": {
                "type": "object",
                "required": [
                    "service",
                    "action"
                ],
                "properties": {
                    "service": {
                        "const": "sampolo"
                    },
                    "action": {
                        "const": "delete"
                    }
                },
                "description": "Delete a row by primary key"
            },
            "sampolo.details": {
                "type": "object",
                "required": [
                    "service",
                    "action"
                ],
                "properties": {
                    "service": {
                        "const": "sampolo"
                    },
                    "action": {
                        "const": "details"
                    }
                },
                "description": "Alias for the `retrieve` action"
            },
            "sampolo.edit": {
                "type": "object",
                "required": [
                    "service",
                    "action"
                ],
                "properties": {
                    "service": {
                        "const": "sampolo"
                    },
                    "action": {
                        "const": "edit"
                    }
                },
                "description": "Alias for the `update` action"
            },
            "sampolo.list": {
                "type": "object",
                "required": [
                    "service",
                    "action"
                ],
                "properties": {
                    "service": {
                        "const": "sampolo"
                    },
                    "action": {
                        "const": "list"
                    }
                },
                "description": "List rows with optional pagination"
            },
            "sampolo.random": {
                "type": "object",
                "required": [
                    "service",
                    "action"
                ],
                "properties": {
                    "service": {
                        "const": "sampolo"
                    },
                    "action": {
                        "const": "random"
                    }
                },
                "description": "Return random row(s)"
            },
            "sampolo.retrieve": {
                "type": "object",
                "required": [
                    "service",
                    "action"
                ],
                "properties": {
                    "service": {
                        "const": "sampolo"
                    },
                    "action": {
                        "const": "retrieve"
                    }
                },
                "description": "Fetch one row by primary key"
            },
            "sampolo.save": {
                "type": "object",
                "required": [
                    "service",
                    "action"
                ],
                "properties": {
                    "service": {
                        "const": "sampolo"
                    },
                    "action": {
                        "const": "save"
                    }
                },
                "description": "Alias for the `create` action"
            },
            "sampolo.update": {
                "type": "object",
                "required": [
                    "service",
                    "action"
                ],
                "properties": {
                    "service": {
                        "const": "sampolo"
                    },
                    "action": {
                        "const": "update"
                    }
                },
                "description": "Update an existing row"
            }
        },
        "responses": {
            "PioniaEnvelope": {
                "description": "Pionia JSON envelope",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/PioniaEnvelope"
                        }
                    }
                }
            }
        }
    }
}
