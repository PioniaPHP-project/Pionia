; Production OPcache settings for Pionia (RoadRunner + PHP-FPM).
; Installed by `php pionia optimize` — copy into your php.ini or pool config.

opcache.enable=1
opcache.enable_cli=1
opcache.preload=/app/bootstrap/preload.php
opcache.preload_user=www-data
opcache.validate_timestamps=0
opcache.max_accelerated_files=20000
opcache.memory_consumption=256
opcache.interned_strings_buffer=16
opcache.jit=1255
opcache.jit_buffer_size=128M

; After deploy: php pionia optimize && restart PHP-FPM or RoadRunner workers
