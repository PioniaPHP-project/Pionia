{
    "name": "{{VENDOR}}/{{APP_SLUG}}",
    "description": "{{APP_NAME}} — Pionia application",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "ext-pdo": "*",
        "pionia/pionia-core": "^3.0",
        "react/promise": "^3.2"
    },
    "require-dev": {
        "spiral/roadrunner-http": "^3.5",
        "spiral/roadrunner-cli": "^2.6",
        "spiral/roadrunner-jobs": "^4.0",
        "nyholm/psr7": "^1.8"
    },
    "suggest": {
        "roadrunner-php/centrifugo": "WebSocket RPC via RoadRunner Centrifuge plugin"
    },
    "scripts": {
        "serve": "php pionia serve",
        "runserver": "php pionia runserver",
        "rr:setup": "@php pionia rr:setup",
        "optimize": "@php pionia optimize",
        "test": "php vendor/bin/phpunit",
        "pionia": "php pionia",
        "post-create-project-cmd": [
            "Pionia\\Scaffolding\\PostCreateProjectHandler::handle"
        ],
        "post-install-cmd": [
            "@php -r \"if (is_file('vendor/bin/rr') && !is_file('rr')) { echo \\\"Run: composer rr:setup to install the RoadRunner binary\\\\n\\\"; }\""
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
