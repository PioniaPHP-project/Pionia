#!/usr/bin/env bash
# Download the RoadRunner binary into the app root and verify PHP worker packages.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

if [[ ! -f vendor/autoload.php ]]; then
  echo "Run composer install first." >&2
  exit 1
fi

if ! php -r "require 'vendor/autoload.php'; exit(class_exists(\Spiral\RoadRunner\Http\PSR7Worker::class) ? 0 : 1);"; then
  echo "RoadRunner PHP packages missing. Run: composer install" >&2
  exit 1
fi

RR_GET="$ROOT/vendor/bin/rr"
if [[ ! -x "$RR_GET" ]]; then
  echo "spiral/roadrunner-cli not found. Run: composer install" >&2
  exit 1
fi

echo "==> Downloading RoadRunner binary to $ROOT/rr"
"$RR_GET" get -l "$ROOT" -n

if [[ ! -x "$ROOT/rr" ]]; then
  echo "Failed to install ./rr" >&2
  exit 1
fi

echo "==> RoadRunner binary"
"$ROOT/rr" --version

echo "==> Worker entry"
test -f "$ROOT/worker.php" && test -f "$ROOT/.rr.yaml"

echo "==> Ready: php pionia runserver"
