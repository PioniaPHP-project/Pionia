[server]
NOT_FOUND_CODE=404
UNAUTHENTICATED_CODE=401
SERVER_ERROR_CODE=500

[logging]
LOG_FORMAT=TEXT
HIDE_IN_LOGS=password,pin,token

[exceptions]
RENDER_TRACES=true

[db]
database_type=sqlite
database_name=database.sqlite3
default=true

[cors]
allowed_origins=http://localhost:5173,http://127.0.0.1:5173
allowed_headers=*
credentials=true

[roadrunner]
HOST=127.0.0.1
PORT=8003

[jobs]
# Set ENABLED=true when using php pionia runserver with RR jobs pool
ENABLED=false
PIPELINE=moonlight
RPC=tcp://127.0.0.1:6001

[realtime]
ENABLED=false
CHANNEL_PREFIX=moonlight
