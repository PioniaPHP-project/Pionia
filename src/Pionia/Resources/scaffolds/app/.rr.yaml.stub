version: "3"

rpc:
  listen: tcp://127.0.0.1:6001

server:
  command: "php worker.php"
  relay: pipes

http:
  address: 127.0.0.1:8003
  pool:
    num_workers: 2

jobs:
  consume: ["moonlight"]
  pool:
    num_workers: 2
  pipelines:
    moonlight:
      driver: memory
      # Production: switch to redis (see docs — background jobs)
      # driver: redis
      # config:
      #   addrs: ["127.0.0.1:6379"]

logs:
  mode: development
  level: info
