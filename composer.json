{
    "name": "pionia/pionia-core",
    "description": "PHP REST-API framework for developers with deadlines",
    "type": "library",
    "license": "MIT",
    "keywords": ["php", "framework", "jet2018", "service", "j2j", "Pioneer", "Pionia", "architecture", "performance"],
    "autoload": {
        "psr-4": {
            "Pionia\\": "src/Pionia/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Application\\": "example/",
            "Application\\Services\\": "example/services/",
            "Application\\Switches\\": "example/switches/",
            "Application\\Authentications\\": "example/authentications/",
            "Application\\Middlewares\\": "example/middlewares/",
            "Application\\Commands\\": "example/commands/"
        }
    },
    "authors": [
        {
            "name": "jet2018",
            "email": "ezrajet9@gmail.com",
            "role": "Author"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "php": ">=8.5",
        "spiral/roadrunner-http": "^3.5",
        "spiral/roadrunner-cli": "^2.6",
        "nyholm/psr7": "^1.8",
        "spiral/roadrunner-jobs": "^4.0",
        "react/promise": "^3.2",
        "react/promise": "^3.2"
    },
    "require": {
        "php": ">=8.5",
        "ext-json": "*",
        "ext-pdo": "*",
        "monolog/monolog": "^3.6",
        "nette/php-generator": "^4.1",
        "doctrine/inflector": "^2.0",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "php-di/php-di": "^7.0",
        "nesbot/carbon": "^3.8",
        "psr/cache": "^3.0",
        "psr/simple-cache" : "^1.0",
        "ext-fileinfo": "*"
    },
    "provide": {
        "psr/container-implementation": "2.0"
    },
    "suggest": {
        "spiral/roadrunner-http": "Persistent HTTP workers via RoadRunner (runserver)",
        "spiral/roadrunner-jobs": "Async Moonlight jobs via RoadRunner Jobs plugin",
        "roadrunner-php/centrifugo": "WebSocket RPC via RoadRunner Centrifuge plugin",
        "nyholm/psr7": "PSR-7 messages for RoadRunner integration",
        "ext-apcu": "APCu cache store (cache STORE=apcu; ideal for RoadRunner workers)",
        "ext-redis": "Redis cache store (cache STORE=redis)",
        "react/promise": "Promise chaining for async() background work"
    },
    "scripts": {
        "test": "bash bin/test",
        "test:unit": "bash bin/test --testsuite Unit",
        "test:feature": "bash bin/test --testsuite Feature",
        "test:console": "bash bin/test --testsuite Console",
        "test:docs": "bash bin/test --testsuite Documentation",
        "test:verbose": "bash bin/test --verbose",
        "test:coverage": "php vendor/bin/phpunit --coverage-text --coverage-clover=build/coverage.xml --testdox",
        "test:ci": "mkdir -p build && php vendor/bin/phpunit --coverage-clover=build/coverage.xml --coverage-text",
        "document:api": "php example/pionia api:docs --ui",
        "document:api:check": "php example/pionia api:docs --ui --check",
        "document:framework": "phpDocumentor run --config=phpdoc.dist.xml",
        "document": [
            "@document:framework",
            "@document:api"
        ],
        "changelog": "git log --pretty=format:'- %s' > CHANGELOG.md"
    },
    "archive": {
        "exclude": [
            "example",
            ".phpunit.result.cache",
            "docs",
            "tests",
            "database.sqlite3",
            "phpdoc.dist.xml",
            "phpunit.xml"
        ]
    }
}
